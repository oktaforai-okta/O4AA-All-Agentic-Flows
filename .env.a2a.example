# ─────────────────────────────────────────────────────────────
# Agent-to-Agent (A2A) config — copy to .env.a2a
# Loaded IN ADDITION to .env (shared vars like OKTA_* / AGENT_* / SERVICE_* stay in .env).
#
# HI - A2A chain:
#   T1 user login (A2A OIDC app; /authorize carries resource = INVENTORY_AGENT_RESOURCE)
#   T2 Agent 1 id-JAG   → Org auth server; audience = Agent 2 auth server; resource = FINANCE_AGENT_RESOURCE
#   T3 Agent 1 redeem   → Agent 2 auth server (token for Agent 1 to invoke Agent 2)
#   T4 Agent 2 id-JAG   → Org auth server; audience = Finance MCP auth server
#   T5 Agent 2 redeem   → Finance MCP auth server (final access token)
#   T6 call Finance MCP
# ─────────────────────────────────────────────────────────────

# ── A2A OIDC web app (its own client id — public/private key, no secret) ──
# The app has a single login button (regular, .env OKTA_*). When a user selects an
# A2A flow, the app initiates THIS A2A login; its /authorize includes INVENTORY_AGENT_RESOURCE.
# Like the main login app, this one authenticates with private_key_jwt. In Okta set its
# client authentication to "Public key / Private key" and register the SAME public JWK.
A2A_OKTA_ISSUER=https://your-org.okta.com/oauth2/your-auth-server-id
A2A_OKTA_CLIENT_ID=
A2A_OKTA_CLIENT_SECRET=<the A2A login app's client secret>
A2A_OKTA_REDIRECT_URI=http://localhost:8080/api/a2a/callback
A2A_OKTA_SCOPES=openid profile email
A2A_OKTA_TOKEN_AUTH_METHOD=client_secret_basic
# Defaults to OKTA_PRIVATE_KEY_FILE / OKTA_KID, which default to AGENT_PRIVATE_KEY_FILE /
# AGENT_KID — one keypair for the whole app. Override only for a separate key.
# A2A_OKTA_PRIVATE_KEY_FILE=./keys/agent.pem
# A2A_OKTA_KID=
# Escape hatch if this app is still on secret-based auth:
# A2A_OKTA_TOKEN_AUTH_METHOD=client_secret_basic
# A2A_OKTA_CLIENT_SECRET=

 HI - SAML - Cross-App Access: dedicated agent client_id for this flow's T2 (SAML→refresh),
# T3 (refresh→id-JAG), and T4 (id-JAG→access token) — a separate Okta app registration
# from AGENT_CLIENT_ID, but registered with the SAME public JWK (agent.pem / AGENT_KID).
# Falls back to AGENT_CLIENT_ID if left unset.
AGENT_CLIENT_ID_SAML=<the SAML flow's dedicated agent client 



# ── A2A service app (NHI - A2A, T1 client_credentials) — copied from the service app config ──
A2A_SERVICE_CLIENT_ID=
A2A_SERVICE_PRIVATE_KEY_FILE=./keys/service.pem
A2A_SERVICE_KID=
# Auth server the A2A service app gets its token from (T1). Defaults to ORG_AUTH_SERVER.
A2A_SERVICE_ISSUER=
A2A_SERVICE_SCOPES=
A2A_SERVICE_AUDIENCE=
A2A_SERVICE_RESOURCE=
# A2A_SERVICE_SUBJECT_TOKEN_TYPE=urn:ietf:params:oauth:token-type:access_token

# ORG authorization server — ALL id-JAG (token-exchange) requests (T2 + T4) go here.
# Its /v1/token endpoint is derived. Defaults to AGENT_AUTH_SERVER if blank.
ORG_AUTH_SERVER=https://your-org.okta.com/oauth2/org-auth-server-id

# ── Agent 1 (Inventory) ── requests T2 id-JAG, redeems T3 at Agent 2's auth server.
INVENTORY_AGENT_CLIENT_ID=
# Optional 'scope' on the T2 id-JAG request (omitted if blank).
INVENTORY_AGENT_IDJAG_SCOPES=
# 'resource' sent on the T2 id-JAG request (the Inventory agent resource). Omitted if blank.
INVENTORY_AGENT_RESOURCE=https://agent.inventory.com
# Cert defaults to the agent cert ("same pem for now"):
# INVENTORY_AGENT_PRIVATE_KEY_FILE=./keys/agent.pem
# INVENTORY_AGENT_KID=

# ── Agent 2 (Finance) ── its auth server is the T2 audience + T3 redeem endpoint;
#    it also requests T4 id-JAG and redeems T5 at the Finance MCP auth server.
FINANCE_AGENT_CLIENT_ID=
FINANCE_AGENT_AUTH_SERVER=https://your-org.okta.com/oauth2/finance-agent-auth-server-id
# 'resource' sent on the T2 id-JAG request (the Agent 2 / Finance resource). Omitted if blank.
FINANCE_AGENT_RESOURCE=
# Optional 'scope' on the T4 id-JAG request (omitted if blank).
FINANCE_AGENT_IDJAG_SCOPES=
# Cert defaults to the agent cert:
# FINANCE_AGENT_PRIVATE_KEY_FILE=./keys/agent.pem
# FINANCE_AGENT_KID=

# ── Finance MCP resource server ── T4 id-JAG audience, T5 redeem endpoint, T6 validation.
FINANCE_MCP_AUTH_SERVER=https://your-org.okta.com/oauth2/finance-mcp-auth-server-id
# Optional 'resource' on the T4 id-JAG request (omitted if blank).
FINANCE_MCP_RESOURCE=
# Required scope enforced when validating the final access token at T6 (omitted if blank).
FINANCE_MCP_SCOPES=
